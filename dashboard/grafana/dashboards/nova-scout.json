    {
      "type": "stat",
      "id": 2,
      "title": "Sent today / daily cap",
      "description": "Everything that counts toward the warm-up ceiling today, in the sender's day (Asia/Karachi): every external message the Sent mirror holds (the workflow's, replies, manual sends) plus open claims -- Load Send State's own count. The cap is the Section 5 warm-up ceiling for today. The cap is the mailbox's; with a niche filter, 'sent today' is that niche's share.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "novascout-metrics"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "novascout-metrics"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(counted_toward_cap) AS \"sent today\", max(daily_cap) AS \"daily cap\",\n       max(daily_cap) - sum(counted_toward_cap) AS \"left today\"\n  FROM metrics.sends_daily\n WHERE is_today AND niche IN (${niche:sqlstring})"
        }
      ],
