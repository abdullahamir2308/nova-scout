    {
      "type": "stat",
      "id": 7,
      "title": "Send brake",
      "description": "An open send_pauses row stops Send until the operator clears it (Master Ref Section 9, Workflow 6). Mailbox-wide.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "novascout-metrics"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "novascout-metrics"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN max(open_pauses) = 0 THEN 'Sending: no pause'\n            ELSE 'PAUSED: ' || max(open_pause_reasons) END AS \"send brake\"\n  FROM metrics.deliverability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": null,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^PAUSED.*",
                "result": {
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^Sending.*",
                "result": {
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^send brake$/",
          "values": false
        },
