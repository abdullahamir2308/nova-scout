    {
      "type": "stat",
      "id": 4,
      "title": "Approved queue left",
      "description": "Approved email drafts Send can still take (Load Send State's filter: approved, email, not a reply, source not held), divided by the cold sends of the last 7 days per day. Blank when nothing was sent in that window.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "novascout-metrics"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "novascout-metrics"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(approved_queue) AS \"approved emails\",\n       round(sum(cold_sends_in_window)::numeric / max(rate_window_days), 1) AS \"sends / day (last 7 days)\",\n       round(sum(approved_queue) / nullif(sum(cold_sends_in_window)::numeric / max(rate_window_days), 0), 1) AS \"days left\"\n  FROM metrics.queue_runway\n WHERE niche IN (${niche:sqlstring})"
        }
      ],
