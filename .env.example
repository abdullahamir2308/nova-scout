# Postgres — single container, two databases (n8n, novascout)
POSTGRES_USER=
POSTGRES_PASSWORD=

# n8n
# Encrypts stored credentials. Set once, never regenerate — if this
# changes after credentials exist in n8n, they become permanently unreadable.
# Generate with: openssl rand -hex 32 (or PowerShell RNGCryptoServiceProvider)
N8N_ENCRYPTION_KEY=
