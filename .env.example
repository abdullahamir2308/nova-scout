# Postgres — single container, two databases (n8n, novascout)
POSTGRES_USER=
POSTGRES_PASSWORD=

# n8n
# Encrypts stored credentials. Set once, never regenerate — if this
# changes after credentials exist in n8n, they become permanently unreadable.
# Generate with: openssl rand -hex 32 (or PowerShell RNGCryptoServiceProvider)
N8N_ENCRYPTION_KEY=

# Sender identity (Section 5) -- baked into drafts and checked on every send
NOVASCOUT_SENDER_NAME=
NOVASCOUT_SENDER_TITLE=
NOVASCOUT_SENDER_PHONE=

# Outreach mailbox (Section 5). Read by n8n/sendtrack/provision_credentials.py
# into the n8n SMTP/IMAP credentials -- the workflow JSON never holds them.
NOVASCOUT_MAILBOX_ADDRESS=
NOVASCOUT_MAILBOX_PASSWORD=
NOVASCOUT_IMAP_HOST=
NOVASCOUT_SMTP_HOST=
NOVASCOUT_SMTP_PORT=

# Where Workflow 6's reply notifications go -- the operator's own inbox, never
# the outreach mailbox (Section 9). Unset = no notification email.
NOVASCOUT_OPERATOR_EMAIL=
