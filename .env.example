# Postgres — single container, two databases (n8n, novascout)
POSTGRES_USER=
POSTGRES_PASSWORD=

# n8n
# Encrypts stored credentials. Set once, never regenerate — if this
# changes after credentials exist in n8n, they become permanently unreadable.
# Generate with: openssl rand -hex 32 (or PowerShell RNGCryptoServiceProvider)
N8N_ENCRYPTION_KEY=

# Sender identity (Section 5) -- baked into drafts and checked on every send
NOVASCOUT_SENDER_NAME=
NOVASCOUT_SENDER_TITLE=
NOVASCOUT_SENDER_PHONE=

# Outreach mailbox (Section 5). Read by n8n/sendtrack/provision_credentials.py
# into the n8n SMTP/IMAP credentials -- the workflow JSON never holds them.
NOVASCOUT_MAILBOX_ADDRESS=
NOVASCOUT_MAILBOX_PASSWORD=
NOVASCOUT_IMAP_HOST=
NOVASCOUT_SMTP_HOST=
NOVASCOUT_SMTP_PORT=

# Where Workflow 6's reply notifications go -- the operator's own inbox, never
# the outreach mailbox (Section 9). Not baked into any workflow: after changing
# it, run n8n/sendtrack/sync_settings.py, which writes it to the novascout
# `settings` table that Mailbox Watch reads at runtime. Messages sent only to it
# do not count toward the warm-up ceiling. Unset = no notification email.
# The same address receives the Daily Digest (migration 014).
NOVASCOUT_OPERATOR_EMAIL=

# Auto-approval of email drafts (migration 014): true or false. Unset leaves the
# `settings` row as it is -- seeded true, on by default. Run sync_settings.py
# after changing it; nothing needs rebuilding or re-publishing.
#NOVASCOUT_AUTO_APPROVE_EMAIL=true
